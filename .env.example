# Fayna SES - Edge Environment Variables & Secrets
# Do NOT commit production secrets to public git.
# Set these in Cloudflare Dashboard: Pages -> Settings -> Environment Variables

# Web Push VAPID Keys (Generated with WebCrypto ECDSA P-256)
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@fayna-town.kyiv.ua

# Cryptographically Secure Admin API Key (for /api/admin/metrics & manual push dispatches)
# Generated via crypto.randomBytes(32) - 256-bit entropy
ADMIN_API_KEY=YOUR_256_BIT_ADMIN_API_KEY_HEX
